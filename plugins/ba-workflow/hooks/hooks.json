{
  "description": "Hỏi xác nhận trước khi sửa file BA đã duyệt (baselines.csv).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/guard.py" }
        ]
      }
    ]
  }
}
